# Environment variable template for local/deployed servers. Copy it to `.env`
# and replace every placeholder; never commit the populated `.env` file.

# Application
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:8000
PERSONA_ID_HEADER=Persona-Id

# MongoDB connection storage. Generate an encryption key with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=twynity_mcp
ENCRYPTION_KEY=replace-with-generated-fernet-key

# Sage Business Cloud Accounting OAuth app credentials.
# Register the exact Twynity redirect URI(s) in the Sage developer app and list
# them comma-separated here. Configure SAGE_OAUTH_TOKEN_URL for the app region.
SAGE_CLIENT_ID=replace-with-sage-client-id
SAGE_CLIENT_SECRET=replace-with-sage-client-secret
SAGE_SUBSCRIPTION_KEY=replace-with-sage-accounting-api-subscription-key
SAGE_OAUTH_AUTHORIZE_URL=https://www.sageone.com/oauth2/auth/central
SAGE_OAUTH_TOKEN_URL=https://app.sageone.com/oauth2/token
SAGE_OAUTH_SCOPES=full_access
SAGE_OAUTH_REDIRECT_URIS=https://twynity.example.com/oauth/callback
SAGE_API_BASE_URL=https://api.accounting.sage.com/v3.1

# Usage reporting
USAGE_REPORT_ENDPOINT=https://example.com/usage

# Account service authentication
ACCOUNT_SERVICE_URL=https://accounts.example.com
ACCOUNT_SERVICE_JWKS_ENDPOINT=/.well-known/jwks.json
ACCOUNT_SERVICE_JWKS_CACHE_TTL=3600

# License service
LICENSE_KEY=replace-me
LICENSE_SERVER_BASE_URL=https://licenses.example.com
LICENSE_SERVER_JWKS_ENDPOINT=/.well-known/jwks.json
LICENSE_SERVER_ACTIVATION_ENDPOINT=/activate
